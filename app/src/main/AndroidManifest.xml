<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera permission for scanning barcodes -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Internet permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_book_placeholder"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_book_placeholder"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersonalLibrary"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Main launcher activity -->
        <activity
            android:name="com.personallibrary.app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Welcome setup activity -->
        <activity
            android:name="com.personallibrary.app.WelcomeActivity"
            android:exported="false" />

        <!-- Book detail activity -->
        <activity
            android:name="com.personallibrary.app.BookDetailActivity"
            android:parentActivityName="com.personallibrary.app.MainActivity" />

        <!-- Add book activity -->
        <activity
            android:name="com.personallibrary.app.AddBookActivity"
            android:parentActivityName="com.personallibrary.app.MainActivity" />

        <!-- Barcode scanner activity -->
        <activity
            android:name="com.personallibrary.app.BarcodeScannerActivity"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />

        <!-- Manage readers activity -->
        <activity
            android:name="com.personallibrary.app.ManageReadersActivity"
            android:parentActivityName="com.personallibrary.app.MainActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.personallibrary.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
