<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera permission for scanning barcodes -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Internet permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Storage permissions for picking book covers -->
    <!-- Android 14+ (Partial access) -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Storage permissions for older Android versions (Below API 33) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Only needed if saving files/exports to public folders (Below API 29) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_book_placeholder"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_book_placeholder"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersonalLibrary"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Main launcher activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Welcome setup activity -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="false" />

        <!-- Book detail activity -->
        <activity
            android:name=".BookDetailActivity"
            android:parentActivityName=".MainActivity" />

        <!-- Add book activity -->
        <activity
            android:name=".AddBookActivity"
            android:parentActivityName=".MainActivity" />

        <!-- Barcode scanner activity -->
        <activity
            android:name=".BarcodeScannerActivity"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />

        <!-- Manage readers activity -->
        <activity
            android:name=".ManageReadersActivity"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>
